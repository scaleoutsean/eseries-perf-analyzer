[global]
filename=test.img
size=100m
rw=write
bs=1024k
ioengine=libaio
direct=1
rate_iops=10
time_based
runtime=900
exitall_on_error=1 
write_bw_log=/data/fio_logs/fio
write_iops_log=/data/fio_logs/fio
write_lat_log=/data/fio_logs/fio
log_avg_msec=1000

[write]
name=write
rw=write

[read]
name=read
rw=read
startdelay=1200
stonewall
