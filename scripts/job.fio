[global]
filename=test.img
size=100m
rw=write
bs=1024k
ioengine=libaio
direct=1
rate_iops=10
time_based
runtime=900
exitall_on_error=1 
write_bw_log=/fio_logs/
write_iops_log=/fio_logs/
write_lat_log=/fio_logs/
log_avg_msec=1000
progress

[write]
name=write
rw=write

[read]
name=read
rw=read
startdelay=1200
stonewall
